# Supabase Configuration
# These environment variables are required for the application to connect to Supabase

# Public Supabase URL - this is safe to expose in client-side code
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anonymous key - this is safe to expose in client-side code
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - this should be kept secret and only used in server-side code
# This key has full access to your database and should not be exposed to clients
SUPABASE_SERVICE_ROLE_KEY=